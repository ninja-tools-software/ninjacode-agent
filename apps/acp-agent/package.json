{
  "name": "@ninjacode/acp-agent",
  "version": "0.1.0",
  "description": "NinjaCode Agent Client Protocol (ACP) server for JetBrains, Zed, Neovim",
  "license": "GPL-2.0-only",
  "type": "module",
  "bin": {
    "ninjacode-acp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "bundle": "node esbuild.mjs"
  },
  "dependencies": {
    "@ninjacode/core": "workspace:*",
    "@ninjacode/providers": "workspace:*",
    "@ninjacode/tools": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
