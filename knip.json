{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{ts,mjs,cjs}"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/eval.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/acp-agent": {
      "project": ["src/**/*.ts"]
    },
    "apps/bench": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/vscode": {
      "entry": ["src/extension.ts", "src/**/*.test.ts", "webview/src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.ts", "webview/src/**/*.{ts,tsx}"]
    }
  }
}
