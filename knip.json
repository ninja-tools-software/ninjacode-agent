{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["apps/bench/tasks/**/fixture/**"],
  "workspaces": {
    ".": {
      "project": ["*.{ts,mjs,cjs}"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/cli": {
      "entry": ["src/eval.ts", "esbuild.mjs"],
      "project": ["src/**/*.ts", "esbuild.mjs"]
    },
    "apps/acp-agent": {
      "entry": ["esbuild.mjs"],
      "project": ["src/**/*.ts", "esbuild.mjs"]
    },
    "apps/bench": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/vscode": {
      "entry": [
        "src/extension.ts",
        "src/e2e/extensionHost.ts",
        "src/**/*.test.ts",
        "webview/src/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.ts", "webview/src/**/*.{ts,tsx}"]
    }
  }
}
