{
  "name": "@ninjacode/core",
  "version": "0.1.0",
  "description": "NinjaCode agent harness — loop, context, permissions, checkpoints",
  "license": "GPL-2.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@ninjacode/providers": "workspace:*",
    "@ninjacode/tools": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
